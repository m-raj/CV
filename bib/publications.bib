@article{RAJ2026106807,
title = {A neural-network framework to learn history-dependent constitutive laws and identifiability of internal variables},
journal = {Journal of the Mechanics and Physics of Solids},
volume = {217},
pages = {106807},
year = {2026},
issn = {0022-5096},
doi = {https://doi.org/10.1016/j.jmps.2026.106807},
url = {https://www.sciencedirect.com/science/article/pii/S002250962600308X},
author = {Mayank Raj and Lianghao Cao and Andrew Stuart and Kaushik Bhattacharya},
keywords = {Polyconvex neural network, Crystal plasticity, Internal variables, Numerical homogenisation},
author+an={1=highlight},
verba = {https://m-raj.github.io/projects/neural-constitutive-laws/},
usera = {Built a causal, energy-based neural-network framework for learning history-dependent constitutive laws that is thermodynamically consistent and stable by construction.},
userb = {Showed empirically, and proved under controllability assumptions, that the learned internal variables are identifiable up to a linear transform.},
userc = {Learned the averaged response of a polycrystalline magnesium cell with 2\% relative error, replacing costly multiscale (FE$^2$) simulations.},
abstract = {The identification of constitutive laws is ubiquitous in engineering: in modeling of materials, where experimental data are fitted to mathematical models or learning surrogate models to beat the FE2 computational cost of multiscale numerical simulations. However, these models of constitutive laws, unless equipped with a energetic formulation, are not necessarily consistent with (a) the second law of thermodynamics; (b) stability of the material under extreme applied strain; and (c) the mathematical theory underpinning the existence of a solution of the non-linear momentum balance equation. In this work, we present a causal and energetic formulation, consistent with the aforementioned properties, of learning a history-dependent constitutive law. Moreover, we empirically discover, and, under controllability assumptions, theoretically show that the internal variables that are inferred from a learned constitutive model are identifiable up to a linear transform. This characterisation of the class of internal variables sheds light on an equivalence class of models that lead to the same stress-strain map. The framework is deployed to learn the Taylor-averaged response of a polycrystalline magnesium unit cell. We achieve a 2\% relative error in the prediction of the Taylor-averaged response.}
}





